  "ranked": [
    {
      "body": "A partial refund reuses the same idempotency key. See \`src/payments/refund.ts\` for the canonical implementation. Partial refunds must be ledgered against the original charge.",
      "contexttrail": "Source: docs/payments/refunds.md > Section: Refunds > Partial refunds > Part: 1/1",
      "end_line": 8,
