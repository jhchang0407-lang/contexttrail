        "symbols": [
          "RefundService.processRefund",
        ],
      },
      "score": 0.1495,
      "tokens": 61,
      "type_bias_applied": false,
    },
    {
      "body": "Subscriptions follow a lifecycle: \`active → canceling → canceled\` for cancellations, and \`active → upgrading → active\` for plan upgrades. Every state transition is logged to the \`billing_audit_events\` table.",
      "contexttrail": "Source: docs/billing/subscriptions.md > Section: Subscriptions > Part: 1/1",
      "id": "ee127d7db1fc0ece",
      "kind": "chunk",
      "scope": {
