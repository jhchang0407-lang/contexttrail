    {
      "body": "Endpoints must tolerate duplicate deliveries. Each payload includes an \`event_id\` field that is stable across retries — receivers should use \`event_id\` as the deduplication key.",
      "contexttrail": "Source: docs/notifications/webhooks.md > Section: Webhooks > Deduplication > Part: 1/1",
      "id": "d8eef556768aaee1",
