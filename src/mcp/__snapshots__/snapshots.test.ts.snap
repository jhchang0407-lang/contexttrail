        "project": "payments",
        "source": {
          "config_rule": "docs-project-default",
          "frontmatter": true,
        },
        "symbols": [
          "RefundService.processRefund",
        ],
      },
      "score": 0.0954,
      "tokens": 40,
      "type_bias_applied": false,
    },
    {
      "body": "All subscription state transitions — including cancellation and upgrade — are recorded in \`billing_audit_events\`. The \`before_state\`, \`after_state\`, and \`actor\` fields are required. Writes go through the subscription service only; do not write to \`billing_audit_events\` directly.",
      "contexttrail": "Source: docs/billing/subscriptions.md > Section: Subscriptions > Billing audit > Part: 1/1",
      "id": "e8aabe8df9e36300",
      "kind": "chunk",
      "scope": {
        "files": [
          "src/billing/subscription.ts",
