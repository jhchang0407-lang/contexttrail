          "WebhookDispatcher.retry",
        ],
      },
      "score": 0.1129,
      "tokens": 35,
      "type_bias_applied": false,
    },
    {
      "body": "\`InvoiceService.capture\` finalizes a draft invoice and triggers payment collection. Once captured, an invoice is **immutable** — line items must not be modified after capture. Only status transitions are permitted on a captured invoice.",
      "contexttrail": "Source: docs/billing/invoices.md > Section: Invoices > Capture > Part: 1/1",
      "id": "d9e8deaa2c217935",
      "kind": "chunk",
      "scope": {
        "files": [
          "src/billing/invoice.ts",
        ],
        "layer": "module",
        "module": "invoices",
        "project": "billing",
        "source": {
          "config_rule": "docs-project-default",
          "frontmatter": true,
        },
        "symbols": [
