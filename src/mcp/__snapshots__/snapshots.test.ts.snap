    {
      "body": "Every state transition on a payment must produce an audit event in the \`payment_audit_events\` table. The \`AuditLogger.record\` method is the only path; do not write to the table directly. See \`src/payments/audit.ts\`.",
      "contexttrail": "Source: docs/payments/audit.md > Section: Payment audit logging > Part: 1/1",
      "id": "557acc192dbf5d2b",
      "kind": "chunk",
