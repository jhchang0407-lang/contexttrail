{
  "name": "contexttrail",
  "version": "0.1.0-beta.0",
  "description": "Local context engine for document-heavy agent work",
  "keywords": [
    "context-engine",
    "retrieval",
    "rag",
    "mcp",
    "mcp-server",
    "agents",
    "documents",
    "pdf",
    "docx",
    "local-first"
  ],
  "author": "Thomas Chang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhchang0407-lang/contexttrail.git"
  },
  "bugs": {
    "url": "https://github.com/jhchang0407-lang/contexttrail/issues"
  },
  "homepage": "https://github.com/jhchang0407-lang/contexttrail#readme",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "contexttrail": "./dist/cli/main.js"
  },
  "main": "./dist/cli/main.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean --silent && tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "build:all": "npm run clean --silent && tsc -p tsconfig.json && chmod +x dist/cli/main.js",
    "prepack": "npm run build --silent",
    "eval:document-workflow": "npm run build:all --silent && node dist/eval/document-workflow-probe.js",
    "eval:document-workflow:trace": "npm run build:all --silent && node dist/eval/document-workflow-probe.js --trace-dir=.contexttrail/eval-runs/document-workflow-latest",
    "eval:document-workflow:panel": "npm run build:all --silent && node dist/eval/document-workflow-panel.js",
    "eval:document-workflow:panel:trace": "npm run build:all --silent && node dist/eval/document-workflow-panel.js --trace-dir=.contexttrail/eval-runs/document-workflow-panel-latest",
    "eval:document-workflow:hybrid": "npm run build:all --silent && node dist/eval/document-workflow-hybrid-panel.js",
    "eval:document-workflow:hybrid:trace": "npm run build:all --silent && node dist/eval/document-workflow-hybrid-panel.js --trace-dir=.contexttrail/eval-runs/document-workflow-hybrid-latest",
    "eval:document-workflow:hybrid:mutations": "npm run build:all --silent && node dist/eval/document-workflow-hybrid-mutations.js",
    "eval:document-workflow:hybrid:mutations:trace": "npm run build:all --silent && node dist/eval/document-workflow-hybrid-mutations.js --trace-dir=.contexttrail/eval-runs/document-workflow-hybrid-mutations-latest",
    "eval:document-workflow:robust": "npm run build:all --silent && node dist/eval/document-workflow-robust-panel.js",
    "eval:document-workflow:robust:trace": "npm run build:all --silent && node dist/eval/document-workflow-robust-panel.js --trace-dir=.contexttrail/eval-runs/document-workflow-robust-latest",
    "eval:document-workflow:robust:ablation": "npm run build:all --silent && node dist/eval/document-workflow-ablation.js",
    "eval:document-workflow:robust:ablation:trace": "npm run build:all --silent && node dist/eval/document-workflow-ablation.js --trace-dir=.contexttrail/eval-runs/document-workflow-ablation-latest",
    "eval:document-workflow:robust:mutations": "npm run build:all --silent && node dist/eval/document-workflow-robust-mutations.js",
    "eval:document-workflow:robust:mutations:trace": "npm run build:all --silent && node dist/eval/document-workflow-robust-mutations.js --trace-dir=.contexttrail/eval-runs/document-workflow-robust-mutations-latest",
    "eval:document-workflow:confidence": "npm run build:all --silent && node dist/eval/document-workflow-confidence-calibration.js",
    "eval:document-format-stress": "npm run build:all --silent && node dist/eval/document-format-stress.js",
    "eval:vocab-recall": "tsx src/eval/vocab-recall.ts",
    "eval:document-workflow:mutations": "npm run build:all --silent && node dist/eval/document-workflow-mutations.js",
    "eval:document-workflow:mutations:trace": "npm run build:all --silent && node dist/eval/document-workflow-mutations.js --trace-dir=.contexttrail/eval-runs/document-workflow-mutations-latest",
    "eval:contract-policy": "npm run build:all --silent && node dist/eval/document-workflow-probe.js --fixture=tests/fixtures/document-workflows/contract-policy-review/workflows.yaml",
    "eval:contract-policy:trace": "npm run build:all --silent && node dist/eval/document-workflow-probe.js --fixture=tests/fixtures/document-workflows/contract-policy-review/workflows.yaml --trace-dir=.contexttrail/eval-runs/contract-policy-latest",
    "eval:numeric-reconciliation": "npm run build:all --silent && node dist/eval/document-workflow-probe.js --fixture=tests/fixtures/document-workflows/numeric-reconciliation/workflows.yaml",
    "eval:numeric-reconciliation:trace": "npm run build:all --silent && node dist/eval/document-workflow-probe.js --fixture=tests/fixtures/document-workflows/numeric-reconciliation/workflows.yaml --trace-dir=.contexttrail/eval-runs/numeric-reconciliation-latest",
    "eval:relationship-history": "npm run build:all --silent && node dist/eval/document-workflow-probe.js --fixture=tests/fixtures/document-workflows/relationship-history/workflows.yaml",
    "eval:relationship-history:trace": "npm run build:all --silent && node dist/eval/document-workflow-probe.js --fixture=tests/fixtures/document-workflows/relationship-history/workflows.yaml --trace-dir=.contexttrail/eval-runs/relationship-history-latest",
    "eval:employee-operations": "npm run build:all --silent && node dist/eval/document-workflow-probe.js --fixture=tests/fixtures/document-workflows/employee-operations/workflows.yaml",
    "eval:employee-operations:trace": "npm run build:all --silent && node dist/eval/document-workflow-probe.js --fixture=tests/fixtures/document-workflows/employee-operations/workflows.yaml --trace-dir=.contexttrail/eval-runs/employee-operations-latest",
    "eval:vendor-onboarding": "npm run build:all --silent && node dist/eval/document-workflow-probe.js --fixture=tests/fixtures/document-workflows/vendor-onboarding-compliance/workflows.yaml",
    "eval:vendor-onboarding:trace": "npm run build:all --silent && node dist/eval/document-workflow-probe.js --fixture=tests/fixtures/document-workflows/vendor-onboarding-compliance/workflows.yaml --trace-dir=.contexttrail/eval-runs/vendor-onboarding-latest",
    "test": "vitest run",
    "test:watch": "vitest",
    "contexttrail": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.5.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "gpt-tokenizer": "^2.5.1",
    "gray-matter": "^4.0.3",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "stemmer": "^2.0.1",
    "unified": "^11.0.5",
    "yaml": "^2.6.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.7.4",
    "@types/unist": "^3.0.3",
    "fast-check": "^4.7.0",
    "jszip": "^3.10.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.6"
  }
}
